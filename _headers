# Cloudflare Pages headers
# Note: Cloudflare joins repeated headers of the same name with commas, which is
# invalid for Content-Security-Policy — so all policies live in ONE line.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/docs/*
  Content-Disposition: inline

/*.html
  Cache-Control: public, max-age=0, must-revalidate
